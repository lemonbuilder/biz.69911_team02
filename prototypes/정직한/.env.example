# 이 파일을 .env로 복사해 값을 채우세요. .env는 저장소에 올리지 않습니다.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# 분석 엔진: 비워 두면 Claude 키 → Ollama → 규칙 기반 순으로 자동 선택 (claude | ollama | rules)
ANALYZER=
# 로컬 오픈소스 LLM (https://ollama.com 설치 후 `ollama pull qwen2.5:7b`)
OLLAMA_MODEL=
OLLAMA_URL=http://localhost:11434
PORT=3000
CLOVA_INVOKE_URL=
CLOVA_SECRET_KEY=
