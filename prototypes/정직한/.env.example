# 이 파일을 .env로 복사해 값을 채우세요. .env는 저장소에 올리지 않습니다.
# 1순위: 직접 띄운 FreeLLMAPI 주소(예: http://localhost:3001/v1)와 대시보드 Keys 페이지의 통합 키
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=auto:smart
# 2순위: Gemini 무료 키. https://aistudio.google.com/apikey 에서 발급 (카드 불필요)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 분석 엔진: 비워 두면 FreeLLMAPI(OpenAI 호환) → Gemini → Ollama 순으로 자동 선택 (openai | gemini | ollama)
ANALYZER=
# AI 응답을 기다리는 최대 시간(밀리초). 기본 3분
LLM_TIMEOUT_MS=180000
# 로컬 오픈소스 LLM (https://ollama.com 설치 후 `ollama pull qwen2.5:7b`)
OLLAMA_MODEL=
OLLAMA_URL=http://localhost:11434
CLOVA_INVOKE_URL=
CLOVA_SECRET_KEY=
PORT=3000
